# Copy to .env.local (Git ignored). Never commit your real key.
AGENT_PROVIDER=openai
OPENAI_BASE_URL=https://api.deepseek.com
AGENT_MODEL=deepseek-chat
OPENAI_API_KEY=
# Alternative: AGENT_PROVIDER=anthropic; set ANTHROPIC_API_KEY and AGENT_MODEL.
# Optional: ANTHROPIC_BASE_URL=https://your-compatible-service
AGENT_TIMEOUT_SECONDS=90
